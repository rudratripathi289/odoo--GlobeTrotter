generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  USER
  ADMIN
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum Permission {
  VIEW
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  ADVENTURE
  SHOPPING
  CULTURE
  NATURE
  ENTERTAINMENT
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  HOTEL
  FOOD
  OTHER
}

// ============================================================
// USER
// ============================================================

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  username     String   @unique
  email        String   @unique
  passwordHash String
  phone        String?
  photoUrl     String?
  city         String?
  country      String?
  bio          String?
  language     String   @default("en")
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trips                  Trip[]
  sharedTrips            TripShare[]
  savedDestinations      SavedDestination[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

// ============================================================
// COUNTRY
// ============================================================

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  states    State[]
  cities    City[]
  createdAt DateTime @default(now())
}

// ============================================================
// STATE / REGION
// ============================================================

model State {
  id        String   @id @default(uuid())
  countryId String
  name      String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities    City[]
  createdAt DateTime @default(now())

  @@unique([countryId, name])
  @@index([countryId])
}

// ============================================================
// CITY
// ============================================================

model City {
  id         String             @id @default(uuid())
  countryId  String
  stateId    String
  name       String
  popularity Int                @default(0)
  costIndex  Int?
  country    Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  state      State              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  stops      TripStop[]
  activities Activity[]
  savedBy    SavedDestination[]
  createdAt  DateTime           @default(now())

  @@unique([countryId, stateId, name])
  @@index([name])
  @@index([countryId])
  @@index([stateId])
  @@index([popularity])
}

// ============================================================
// TRIP
// ============================================================

model Trip {
  id               String      @id @default(uuid())
  userId           String
  name             String
  description      String?
  startDate        DateTime
  endDate          DateTime
  budget           Decimal?    @db.Decimal(12, 2)
  currency         String      @default("INR")
  coverImage       String?
  visibility       Visibility  @default(PRIVATE)
  copiedFromTripId String?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  copiedFromTrip   Trip?       @relation("TripCopy", fields: [copiedFromTripId], references: [id], onDelete: SetNull)
  copies           Trip[]      @relation("TripCopy")
  stops            TripStop[]
  expenses         Expense[]
  shares           TripShare[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, startDate])
  @@index([visibility, startDate])
  @@index([copiedFromTripId])
}

// ============================================================
// TRIP STOP
// ============================================================

model TripStop {
  id         String         @id @default(uuid())
  tripId     String
  cityId     String
  sequence   Int
  startDate  DateTime
  endDate    DateTime
  budget     Decimal?       @db.Decimal(12, 2)
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  activities TripActivity[]
  expenses   Expense[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([tripId, sequence])
  @@index([cityId])
}

// ============================================================
// MASTER ACTIVITY
// ============================================================

model Activity {
  id             String           @id @default(uuid())
  cityId         String
  name           String
  description    String?
  category       ActivityCategory
  defaultCost    Decimal?         @db.Decimal(12, 2)
  durationMin    Int?
  imageUrl       String?
  city           City             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  tripActivities TripActivity[]
  createdAt      DateTime         @default(now())

  @@index([cityId])
  @@index([name])
  @@index([category])
}

// ============================================================
// TRIP ACTIVITY
// ============================================================

model TripActivity {
  id            String    @id @default(uuid())
  stopId        String
  activityId    String?
  customName    String?
  description   String?
  sequence      Int
  activityDate  DateTime
  startMinute   Int?
  durationMin   Int?
  estimatedCost Decimal?  @db.Decimal(12, 2)
  stop          TripStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([stopId, activityDate, sequence])
  @@index([activityId])
}

// ============================================================
// EXPENSE
// ============================================================

model Expense {
  id          String          @id @default(uuid())
  tripId      String
  stopId      String?
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stop        TripStop?       @relation(fields: [stopId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tripId, expenseDate])
  @@index([stopId])
}

// ============================================================
// TRIP SHARE
// ============================================================

model TripShare {
  id         String     @id @default(uuid())
  tripId     String
  userId     String
  permission Permission @default(VIEW)
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@unique([tripId, userId])
  @@index([userId])
}

// ============================================================
// SAVED DESTINATION
// ============================================================

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  cityId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cityId])
  @@index([cityId])
}

// ============================================================
// PASSWORD RESET TOKEN
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}
